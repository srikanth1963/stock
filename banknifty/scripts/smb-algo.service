[Unit]
Description=SMB Algo Trading Platform
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=srikanth
Group=srikanth
WorkingDirectory=/opt/smb-algo
Environment="PYTHONPATH=/opt/smb-algo"
ExecStart=/opt/smb-algo/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smb-algo

[Install]
WantedBy=multi-user.target
